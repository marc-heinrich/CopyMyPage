# === CopyMyPage .gitignore ===
# Keep this file at repo root. Adjust as needed.

# System / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/

# Dependencies (add when used)
vendor/
node_modules/

# Build artifacts & archives
dist/
*.zip

# Logs & temp
*.log
tmp/
cache/

# Versioned test sources and synthetic fixtures live in /test/.
# Keep local configuration and generated test output untracked.
/test/.env
/test/.env.*
/test/config.local.php
/test/artifacts/
/test/coverage/
/test/results/

# Local agent instructions / documentation
docs/
deployment/

# Local agent and browser tool state
.agents/
.codex/
.continue/
.playwright-cli/
.playwright-mcp/

# Local-only media & design drafts
media_local/
blueprints/

# Third-party extensions (local only, never commit)
src/_vendor_extensions/
pkg_copymypage/packages/*.zip

# OS / editor misc
*.swp

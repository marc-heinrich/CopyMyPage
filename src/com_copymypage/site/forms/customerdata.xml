<?xml version="1.0" encoding="utf-8"?>
<form addfieldprefix="Joomla\Component\CopyMyPage\Site\Field">
	<fieldset name="personal">
		<field
			name="first_name"
			type="text"
			label="COM_COPYMYPAGE_CUSTOMER_DATA_FIELD_FIRST_NAME"
			class="uk-input"
			filter="string"
			maxlength="255"
			required="true"
			autocomplete="given-name"
		/>
		<field
			name="last_name"
			type="text"
			label="COM_COPYMYPAGE_CUSTOMER_DATA_FIELD_LAST_NAME"
			class="uk-input"
			filter="string"
			maxlength="255"
			required="true"
			autocomplete="family-name"
		/>
		<field
			name="email"
			type="email"
			label="JGLOBAL_EMAIL"
			class="uk-input"
			filter="string"
			maxlength="320"
			required="true"
			validate="email"
			validDomains="com_users.domains"
			autocomplete="email"
		/>
	</fieldset>
	<fieldset name="address">
		<field
			name="street"
			type="text"
			label="COM_COPYMYPAGE_PROFILE_ADDRESS_FIELD_STREET"
			class="uk-input"
			filter="string"
			maxlength="500"
			required="true"
			autocomplete="address-line1"
		/>
		<field
			name="house_number"
			type="text"
			label="COM_COPYMYPAGE_PROFILE_ADDRESS_FIELD_HOUSE_NUMBER"
			class="uk-input"
			filter="string"
			maxlength="100"
			required="true"
			autocomplete="address-line2"
		/>
		<field
			name="postcode"
			type="text"
			label="COM_CONTACT_FIELD_INFORMATION_POSTCODE_LABEL"
			class="uk-input"
			filter="string"
			maxlength="100"
			required="true"
			autocomplete="postal-code"
		/>
		<field
			name="city"
			type="text"
			label="COM_CONTACT_FIELD_INFORMATION_SUBURB_LABEL"
			class="uk-input"
			filter="string"
			maxlength="100"
			required="true"
			autocomplete="address-level2"
		/>
		<field
			name="country_code"
			type="copymypagecountry"
			label="COM_COPYMYPAGE_PROFILE_ADDRESS_FIELD_COUNTRY"
			class="uk-select"
			required="true"
			autocomplete="country"
		>
			<option value="">COM_COPYMYPAGE_PROFILE_ADDRESS_SELECT_COUNTRY</option>
		</field>
		<field
			name="region_code"
			type="copymypageregion"
			label="COM_COPYMYPAGE_PROFILE_ADDRESS_FIELD_REGION"
			class="uk-select"
			autocomplete="address-level1"
		>
			<option value="">COM_COPYMYPAGE_PROFILE_ADDRESS_SELECT_REGION</option>
		</field>
		<field
			name="telephone"
			type="tel"
			label="COM_CONTACT_FIELD_INFORMATION_TELEPHONE_LABEL"
			class="uk-input"
			filter="string"
			maxlength="100"
			autocomplete="tel"
		/>
	</fieldset>
	<fieldset name="account">
		<field
			name="create_account"
			type="checkbox"
			label="COM_COPYMYPAGE_CUSTOMER_DATA_ACCOUNT_TOGGLE"
			class="form-check-input"
			value="1"
			default="0"
			filter="integer"
			role="switch"
			aria-controls="cmp-customer-data-account-fields"
			aria-expanded="false"
		/>
	</fieldset>
</form>

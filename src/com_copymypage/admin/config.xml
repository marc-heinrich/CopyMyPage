<?xml version="1.0" encoding="UTF-8"?>
<config>
  <fieldset
    name="page-metadata"
    label="COM_COPYMYPAGE_FIELD_CONFIG_PAGE_METADATA_LABEL"
    description="COM_COPYMYPAGE_FIELD_CONFIG_PAGE_METADATA_DESC">
    <field
      name="meta_description"
      type="textarea"
      label="COM_COPYMYPAGE_FIELD_CONFIG_META_DESCRIPTION_LABEL"
      description="COM_COPYMYPAGE_FIELD_CONFIG_META_DESCRIPTION_DESC"
      default=""
      rows="3"
      cols="30"
      maxlength="300"
      charcounter="true"
      class="uk-textarea"
      filter="string" />
    <field
      name="meta_keywords"
      type="textarea"
      label="COM_COPYMYPAGE_FIELD_CONFIG_META_KEYWORDS_LABEL"
      description="COM_COPYMYPAGE_FIELD_CONFIG_META_KEYWORDS_DESC"
      default=""
      rows="3"
      cols="30"
      class="uk-textarea"
      filter="string" />
  </fieldset>

  <fieldset
    name="contact-form"
    label="COM_COPYMYPAGE_FIELD_CONFIG_CONTACT_FORM">
    <field
      name="banned_email"
      type="textarea"
      label="COM_COPYMYPAGE_FIELD_CONFIG_BANNED_EMAIL_LABEL"
      description="COM_COPYMYPAGE_FIELD_CONFIG_BANNED_EMAIL_DESC"
      default=""
      rows="3"
      cols="30" />
    <field
      name="banned_subject"
      type="textarea"
      label="COM_COPYMYPAGE_FIELD_CONFIG_BANNED_SUBJECT_LABEL"
      description="COM_COPYMYPAGE_FIELD_CONFIG_BANNED_SUBJECT_DESC"
      default=""
      rows="3"
      cols="30" />
    <field
      name="banned_text"
      type="textarea"
      label="COM_COPYMYPAGE_FIELD_CONFIG_BANNED_TEXT_LABEL"
      description="COM_COPYMYPAGE_FIELD_CONFIG_BANNED_TEXT_DESC"
      default=""
      rows="3"
      cols="30" />
  </fieldset>

  <fieldset
    name="ticket-sales"
    label="COM_COPYMYPAGE_FIELD_CONFIG_TICKET_SALES_LABEL"
    description="COM_COPYMYPAGE_FIELD_CONFIG_TICKET_SALES_DESC">
    <field
      name="ticket_reservation_minutes"
      type="number"
      label="COM_COPYMYPAGE_FIELD_CONFIG_TICKET_RESERVATION_MINUTES_LABEL"
      description="COM_COPYMYPAGE_FIELD_CONFIG_TICKET_RESERVATION_MINUTES_DESC"
      default="15"
      min="5"
      max="60"
      step="1"
      filter="integer" />
  </fieldset>

  <!-- Standard-Reiter "Berechtigungen" -->
  <fieldset
    name="permissions"
    label="JCONFIG_PERMISSIONS_LABEL"
    description="JCONFIG_PERMISSIONS_DESC">
    <field
      name="rules"
      type="rules"
      label="JCONFIG_PERMISSIONS_LABEL"
      filter="rules"
      validate="rules"
      component="com_copymypage"
      section="component" />
  </fieldset>
</config>

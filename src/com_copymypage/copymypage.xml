<?xml version="1.0" encoding="utf-8"?>
<extension type="component" method="upgrade">
  <name>com_copymypage</name>
  <author>Marc Heinrich</author>
  <creationDate>2025-11</creationDate>
  <copyright>(C) 2025 Marc Heinrich</copyright>
  <license>http://www.gnu.org/copyleft/gpl.html GNU/GPL</license>
  <authorEmail>heinrich-marc@gmx.de</authorEmail>
  <authorUrl>https://copymypage.de</authorUrl>
  <version>0.0.18</version>
  <namespace path="src">Joomla\Component\CopyMyPage</namespace>
  <!-- Short description via language constant -->
  <description>COM_COPYMYPAGE_XML_DESCRIPTION</description>
  <accountMenuBootstrap>
    <item
      key="overview"
      title="COM_COPYMYPAGE_DASHBOARD_NAV_OVERVIEW"
      alias="cmp-account-overview"
      icon="grid"
      link="index.php?option=com_copymypage&amp;view=dashboard"
    />
    <item
      key="profile"
      title="COM_COPYMYPAGE_DASHBOARD_NAV_PROFILE"
      alias="cmp-account-profile"
      icon="user"
      link="index.php?option=com_copymypage&amp;view=dashboard&amp;layout=profile"
    />
    <item
      key="security"
      title="COM_COPYMYPAGE_DASHBOARD_NAV_SECURITY"
      alias="cmp-account-security"
      icon="lock"
      link="index.php?option=com_copymypage&amp;view=dashboard&amp;layout=security"
    />
  </accountMenuBootstrap>
  <!-- Installer script (Service Provider aware) -->
  <scriptfile>script.php</scriptfile>
  <install>
    <sql>
      <file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
    </sql>
  </install>
  <update>
    <schemas>
      <schemapath type="mysql">sql/updates/mysql</schemapath>
    </schemas>
  </update>
  <uninstall>
    <sql>
      <file driver="mysql" charset="utf8">sql/uninstall.mysql.utf8.sql</file>
    </sql>
  </uninstall>
  <!-- Site area -->
  <files folder="site">
    <folder>data</folder>
    <folder>forms</folder>
    <folder>src</folder>
    <folder>tmpl</folder>
    <folder>language</folder>
  </files>
  <!-- Media assets -->
  <media folder="media" destination="com_copymypage">
    <folder>css</folder>
    <folder>js</folder>
    <folder>images</folder>
    <filename>joomla.asset.json</filename>
  </media>
  <!-- Libraries files -->
  <files folder="libraries">
    <filename destination="libraries/src/WebAsset/AssetItem">ContentDrawerAssetItem.php</filename>
    <filename destination="libraries/src/WebAsset/AssetItem">CopyMyPageAssetItem.php</filename>
    <filename destination="libraries/src/WebAsset/AssetItem">IsotopeAssetItem.php</filename>
    <filename destination="libraries/src/WebAsset/AssetItem">MmenuLightAssetItem.php</filename>
    <filename destination="libraries/src/WebAsset/AssetItem">PureCounterAssetItem.php</filename>
  </files>
  <!-- Admin area -->
  <administration>
    <menu img="class:gears">com_copymypage</menu>
    <files folder="admin">
      <folder>src</folder>
      <folder>services</folder>
      <folder>tmpl</folder>
      <folder>language</folder>
      <folder>sql</folder>
      <filename>access.xml</filename>
      <filename>config.xml</filename>
    </files>
  </administration>
</extension>
